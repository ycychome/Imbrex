# Copy to a private .env file and replace every placeholder before starting the service.
MEMORY_SERVICE_TOKEN=replace-with-at-least-24-character-local-secret
MEMORY_CONFIG_PATH=../../examples/memory/service.json
NEO4J_PASSWORD=replace-with-local-secret
MEMORY_EXTRACTION_KEY=replace-with-local-secret
MEMORY_EMBEDDING_KEY=replace-with-local-secret
# Only set when vision is enabled in service.json.
MEMORY_VISION_KEY=replace-with-local-secret
